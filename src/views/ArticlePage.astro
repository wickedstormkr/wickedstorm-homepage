---
/**
 * 소식 기사(/news/<id>.html, /en/news/<id>.html …). 지금 사이트 생성기(news-artifacts.mjs)와 같은 모양·메타.
 * 번역이 없는 글은 국문 본문을 lang="ko"로 싣고 안내 한 줄을 두며, 검색에는 국문판만 올린다(noindex).
 */
import Base from '../layouts/Base.astro';
// 페이지 스타일은 공통 스타일(Base: 토큰·기본) 뒤에 온다
import '../styles/article.css';
import { localPost, type Post } from '../lib/posts';
import { describe, pictureHtml, renderBody } from '../lib/article';
import { getUi } from '../lib/content';
import { hasImg, img } from '../lib/images';
import { LANGS, articlePath, homePath, newsPath, type Lang } from '../lib/i18n';
import { phrase } from '../lib/phrase';
import { absUrl, url } from '../lib/url';

interface Props { lang: Lang; post: Post }
const { lang } = Astro.props;
const post = localPost(Astro.props.post, lang);
const ui = getUi(lang);
const t = ui.news;
const fallback = post.contentLang !== lang;
const cl = post.contentLang;
const description = describe(post.summary, post.body);
const thumbName = post.thumb?.replace(/^\.\/img\//, '') ?? null;
const thumb = thumbName && hasImg(thumbName) ? thumbName : null;
// 썸네일이 본문에 이미 있는 그림이면 맨 위에 다시 보이지 않는다(목록 썸네일·공유 이미지로만 쓴다)
const thumbInBody = !!thumb && JSON.stringify(post.body).includes(thumb);
const thumbHtml = thumb && !thumbInBody ? await pictureHtml(thumb, post.alt, '(min-width: 808px) 728px, calc(100vw - 80px)', lang, true) : '';
const body = (await renderBody(post.body, lang)) || `<p>${description}</p>`;
const published = post.date.replace(/\./g, '-');
const path = articlePath(lang, post.id);
const ogImage = thumb ? new URL(img(thumb).src, absUrl('/')).href : '/img/og-image.png';
// 번역이 있는 언어만 서로 가리킨다(국문은 늘 있다)
const alternates = Object.fromEntries(
  LANGS.filter((l) => localPost(Astro.props.post, l).contentLang === l).map((l) => [l, articlePath(l, post.id)]),
) as Partial<Record<Lang, string>>;
const org = { '@type': 'Organization', name: t.publisher, url: absUrl(homePath(lang)) };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title,
  description,
  inLanguage: cl,
  image: [thumb ? new URL(img(thumb).src, absUrl('/')).href : absUrl('/img/og-image.png')],
  datePublished: published,
  articleSection: t.categories[post.category],
  mainEntityOfPage: { '@type': 'WebPage', '@id': absUrl(path) },
  author: org,
  publisher: { ...org, logo: { '@type': 'ImageObject', url: absUrl('/img/og-image.png') } },
};
const back = url(newsPath(lang));
const esc = (v: string) => v.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
---
<Base lang={lang} title={`${post.title} | ${t.siteName}`} description={description} ogTitle={post.title} ogType="article"
  ogImage={ogImage} noindex={fallback}
  path={path} alternates={fallback ? undefined : alternates} homeHref={url(homePath(lang))} current="news" jsonLd={jsonLd}>
  <meta slot="head" property="article:published_time" content={published} />
  <main id="main" tabindex="-1">
    <section class="band page-top">
      <div class="wrap">
        <article class="board-detail" aria-labelledby="article-title">
          <p class="detail-back detail-top"><a href={back}><span aria-hidden="true">←</span> {t.back}</a></p>
          <div class="detail-eyebrow"><span class="ntag">{t.categories[post.category]}</span> <time datetime={published}>{post.date}</time></div>
          {fallback && <p class="detail-note">{t.koOnly}</p>}
          <h1 id="article-title" lang={fallback ? cl : undefined} set:html={phrase(esc(post.title), cl)} />
          {thumbHtml && <figure class="detail-thumb" set:html={thumbHtml} />}
          <div class="detail-body" lang={fallback ? cl : undefined} set:html={body} />
          <p class="detail-back"><a href={back}><span aria-hidden="true">←</span> {t.back}</a></p>
        </article>
      </div>
    </section>
  </main>
</Base>
