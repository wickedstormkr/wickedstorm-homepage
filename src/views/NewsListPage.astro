---
/**
 * 소식 목록(/news.html, /en/news.html …). 제목·요약·본문은 소식 번역(src/content/posts/i18n)에서, 번역이 없는 글은 국문.
 * 분류 버튼은 JS가 있을 때만 거르고, 없으면 모두 보인다.
 */
import Base from '../layouts/Base.astro';
// 페이지 스타일은 공통 스타일(Base: 토큰·기본) 뒤에 온다
import '../styles/cards.css';
import '../styles/article.css';
import NewsCard from '../components/NewsCard.astro';
import { allPosts, localPost } from '../lib/posts';
import { getHome, getUi } from '../lib/content';
import { LANGS, homePath, newsPath, type Lang } from '../lib/i18n';
import { phrase } from '../lib/phrase';
import { sents } from '../lib/sents';
import { url } from '../lib/url';

interface Props { lang: Lang }
const { lang } = Astro.props;
const posts = (await allPosts()).map((p) => localPost(p, lang));
const ui = getUi(lang);
const t = ui.news;
const read = getHome(lang).news.read;
const cats = ['all', 'news', 'story', 'insight'] as const;
const alternates = Object.fromEntries(LANGS.map((l) => [l, newsPath(l)])) as Record<Lang, string>;
---
<Base lang={lang} title={t.metaTitle} description={t.lead} path={newsPath(lang)} alternates={alternates} homeHref={url(homePath(lang))} current="news">
  <main id="main" tabindex="-1">
    <section class="band page-top board" aria-labelledby="board-title">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow"><img class="sym" src={url('/img/symbol.png')} alt="" width="16" height="16" /> Feed · Update</p>
          <h1 class="h-lg" id="board-title" set:html={phrase(t.title, lang)} />
          <p class="sec-lead" set:html={phrase(sents(t.lead), lang)} />
        </div>
        <div class="board-tabs" role="group" aria-label={t.tabsLabel} hidden data-tabs data-count={t.count}>
          {cats.map((c) => <button class="board-tab" type="button" data-cat={c} aria-pressed={c === 'all' ? 'true' : 'false'}>{t.categories[c]}</button>)}
        </div>
        <h2 class="sr-only">{t.listHeading}</h2>
        <p class="sr-only" role="status" aria-live="polite" data-board-status></p>
        <ul class="news-grid" data-board>
          {posts.map((p, i) => (
            <li data-cat={p.category}>
              <NewsCard post={p} lang={lang} more={read} go={ui.open} newWindow={ui.newWindow} priority={i === 0} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Base>
<script>
  // 분류 거르기. 주소 해시(#news, #story, #insight)로 바로 열 수 있다(지금 사이트 news.html과 같은 방식)
  const tabs = document.querySelector<HTMLElement>('[data-tabs]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-board] > li')];
  const status = document.querySelector<HTMLElement>('[data-board-status]');
  if (tabs) {
    tabs.hidden = false;
    const btns = [...tabs.querySelectorAll<HTMLButtonElement>('button')];
    const count = tabs.dataset.count ?? '{n}';
    const apply = (cat: string) => {
      if (!btns.some((b) => b.dataset.cat === cat)) cat = 'all';
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
      let n = 0;
      items.forEach((li) => { const on = cat === 'all' || li.dataset.cat === cat; li.hidden = !on; if (on) n++; });
      const name = btns.find((b) => b.dataset.cat === cat)?.textContent ?? '';
      if (status) status.textContent = `${name} · ${count.replace('{n}', String(n))}`;
    };
    btns.forEach((b) => b.addEventListener('click', () => {
      const cat = b.dataset.cat ?? 'all';
      history.replaceState(null, '', cat === 'all' ? location.pathname : `#${cat}`);
      apply(cat);
    }));
    // 옛 상세 딥링크(news.html#p=<id>)는 기사 주소로 보낸다
    const m = /^#p=([a-z0-9-]+)$/.exec(location.hash);
    if (m) location.replace(new URL(`news/${m[1]}.html`, location.href).href);
    else apply(location.hash.slice(1) || 'all');
  }
</script>
