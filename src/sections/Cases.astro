---
/** 사례(홈): 기관 로고 한 줄 + 대표 사례 셋. 전체는 사례 페이지로 */
import Img from '../components/Img.astro';
import SecHead from '../components/SecHead.astro';
import CaseCard from '../components/CaseCard.astro';
import type { HomeContent } from '../lib/content';
import { pagePath, type Lang } from '../lib/i18n';
import { url } from '../lib/url';

interface Props { lang: Lang; t: HomeContent['cases'] }
const { lang, t } = Astro.props;
const page = url(pagePath(lang, 'cases'));
---
<section class="band" id="references" aria-labelledby="ref-title">
  <div class="wrap">
    <SecHead lang={lang} id="ref-title" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />
    <figure class="ref-logos"><Img name={t.logos.img} alt={t.logos.alt} sizes="(min-width: 1288px) 1240px, calc(100vw - 48px)" /></figure>
    <ul class="case-grid">
      {t.homePick.map((i) => <li><CaseCard lang={lang} c={t.items[i]} labels={t.labels} href={`${page}#${t.items[i].id}`} /></li>)}
    </ul>
    <p class="more-row"><a class="btn s" href={page}>{t.more}</a></p>
  </div>
</section>
