---
/** ⑩ 문의: 지금 운영 중인 문의 서버, 같은 필드(src/scripts/contact-form.ts). 목적 · 유입 기록은 docs/marketing/analytics.md */
import SecHead from '../components/SecHead.astro';
import type { HomeContent, UiText } from '../lib/content';
import type { Lang } from '../lib/i18n';
import { phrase, phraseText } from '../lib/phrase';
import { sents } from '../lib/sents';
import { withBase } from '../lib/url';

interface Props { lang: Lang; t: HomeContent['contact']; ui: UiText; page?: boolean }
/** page: 문의 페이지(머리는 페이지가 h1로 둔다) */
const { lang, t, ui, page = false } = Astro.props;
const f = t.form;
---
<section class="band contact" id="contact" aria-labelledby={page ? undefined : 'contact-title'} aria-label={page ? t.purposes.title : undefined}>
  <div class="wrap">
    {page ? null : <SecHead lang={lang} id="contact-title" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />}
    {/* 문의 목적: 폼의 라디오(form="cform"). 고르면 문의사항 안내 글이 바뀌고, 메일 제목과 분석에 목적이 실린다 */}
    <fieldset class="purposes" aria-describedby="purpose-hint">
      <legend class="purposes-title">{t.purposes.title}</legend>
      <p class="purposes-hint" id="purpose-hint" set:html={phraseText(t.purposes.hint, lang)} />
      <div class="purpose-grid">
        {t.purposes.items.map((p) => (
          <label class="purpose">
            <input type="radio" name="purpose" value={p.id} form="cform" data-placeholder={p.placeholder}
              aria-labelledby={`purpose-${p.id}`} aria-describedby={`purpose-${p.id}-desc`} />
            <span class="purpose-mark" aria-hidden="true"></span>
            <b id={`purpose-${p.id}`}>{p.name}</b><span class="purpose-desc" id={`purpose-${p.id}-desc`}>{p.desc}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <div class="contact-grid">
      <div class="ci-info">
        <span class="lab">{t.info.telLabel}</span><a href="tel:0222051470">02-2205-1470</a>
        <span class="lab">{t.info.emailLabel}</span><a href="mailto:manager@wickedstorm.kr">manager@wickedstorm.kr</a>
        <span class="lab">{t.info.addressLabel}</span><p set:html={t.info.address} />
        <p class="ci-note" set:html={phrase(sents(t.info.note), lang)} />
      </div>
      <form class="cform" id="cform" novalidate data-msg={JSON.stringify(ui.form)}>
        <noscript><p set:html={f.noscript} /></noscript>
        <div class="row2">
          <label><span set:html={f.name.label} /><input type="text" name="userName" required autocomplete="name" placeholder={f.name.placeholder} /></label>
          <label><span set:html={f.company.label} /><input type="text" name="userCompany" required autocomplete="organization" placeholder={f.company.placeholder} /></label>
        </div>
        <label><span set:html={f.email.label} /><input type="email" name="userEmail" required autocomplete="email" placeholder={f.email.placeholder} /></label>
        <label><span set:html={f.traffic.label} />
          <select name="userTraffic" required>
            {f.traffic.options.map((o) => <option value={o.value} data-auto={o.auto}>{o.label}</option>)}
          </select>
        </label>
        <label data-etc hidden><span data-etc-label set:html={f.trafficEtc.label} /><input type="text" name="userTrafficEtc" placeholder={f.trafficEtc.placeholder} /></label>
        <label><span set:html={f.memo.label} /><textarea name="userMemo" rows="5" required placeholder={f.memo.placeholder}></textarea></label>
        <label class="hp" aria-hidden="true">website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        <label class="check"><input type="checkbox" name="checkPrivacy" required /> <span set:html={withBase(f.privacy)} /></label>
        <button class="btn p" type="submit" data-submit>{f.submit}</button>
        <p class="status" role="status" aria-live="polite" data-status></p>
      </form>
    </div>
  </div>
</section>
<script>
  import '../scripts/contact-form';
</script>
