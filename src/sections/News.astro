---
/**
 * ⑦ 최근 소식: 소식 컬렉션의 고정(pinned) 글 세 장. 제목·대체 글은 소식 번역(src/content/posts/i18n)에서,
 * 번역이 없는 글은 국문 제목에 lang="ko"를 붙인다. 소식 목록으로 가는 버튼은 다른 섹션처럼 섹션 끝(보조 버튼).
 */
import NewsCard from '../components/NewsCard.astro';
import type { HomeContent, UiText } from '../lib/content';
import { newsPath, type Lang } from '../lib/i18n';
import { homePosts, localPost } from '../lib/posts';
import { phrase } from '../lib/phrase';
import { url } from '../lib/url';

interface Props { lang: Lang; t: HomeContent['news']; ui: UiText }
const { lang, t, ui } = Astro.props;
const posts = (await homePosts(3)).map((p) => localPost(p, lang));
---
<section class="band" id="news" aria-labelledby="news-title">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow"><img class="sym" src={url('/img/symbol.png')} alt="" width="16" height="16" loading="lazy" /> <span set:html={t.eyebrow} /></p>
      <h2 class="h-lg" id="news-title" set:html={phrase(t.title, lang)} />
    </div>
    <ul class="news-grid">
      {posts.map((p) => (
        <li><NewsCard post={p} lang={lang} more={t.read} go={ui.open} newWindow={ui.newWindow} /></li>
      ))}
    </ul>
    <p class="more-row"><a class="btn s" href={url(newsPath(lang))}>{t.more}</a></p>
    <div class="channels" data-social-group hidden>
      <div class="ch-copy">
        <p class="ch-title" set:html={t.channels.title} />
        <p class="ch-sub" set:html={t.channels.sub} />
      </div>
      <div class="ch-links">
        <a class="ch-link" data-social="instagram" href="#" target="_blank" rel="noopener noreferrer" hidden><span class="ch-k">Instagram</span><span class="ch-v" data-social-handle>{t.channels.instagram}</span></a>
        <a class="ch-link" data-social="blog" href="#" target="_blank" rel="noopener noreferrer" hidden><span class="ch-k">Blog</span><span class="ch-v" data-social-handle>{t.channels.blog}</span></a>
      </div>
    </div>
  </div>
</section>
