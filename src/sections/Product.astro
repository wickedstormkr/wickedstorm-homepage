---
/** 제품(홈): 역할별 제품 화면 탭 + 두 솔루션(Lecognizer 계열 · LearnHubble AI). 카드의 자세히 보기는 각 솔루션 사이트(새 창)로(SHOW_SOLUTION_SITES가 꺼져 있으면 없다), 아래 버튼은 제품 페이지로(숨긴 동안은 없다) */
import SecHead from '../components/SecHead.astro';
import RoleTabs from '../components/RoleTabs.astro';
import type { HomeContent } from '../lib/content';
import { isListed, pagePath, type Lang } from '../lib/i18n';
import { url } from '../lib/url';
import { getUi } from '../lib/content';
import { SHOW_SOLUTION_SITES } from '../config/client';

interface Props { lang: Lang; t: HomeContent['product']; story: HomeContent['story'] }
const { lang, t, story } = Astro.props;
const page = url(pagePath(lang, 'product'));
const ui = getUi(lang);
---
<section class="band" id="product" aria-labelledby="product-title">
  <div class="wrap">
    <SecHead lang={lang} id="product-title" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />
    <RoleTabs lang={lang} t={t} story={story} id="home-role" />
    <!-- 두 솔루션: Lecognizer 계열(Lecognizer · Lecognizer AI)과 LearnHubble AI. 각 솔루션 사이트로 이어진다 -->
    <ul class="prod-cards">
      {t.solutions.map((c) => (
        <li class:list={['prod-card', c.cls]}>
          <p class="kick">{c.kicker}</p>
          <h3 class="prod-names">{c.names.map((n) => <span>{n}</span>)}</h3>
          <p set:html={c.text} />
          <ul class="prod-badges">{c.badges.map((b) => <li>{b}</li>)}</ul>
          {SHOW_SOLUTION_SITES && (
            <div class="prod-links">
              <a class="btn s" href={c.site} target="_blank" rel="noopener"><span>{c.more}</span><small lang="en">{c.siteLabel}</small><span class="sr-only"> {ui.newWindow}</span></a>
            </div>
          )}
        </li>
      ))}
    </ul>
    {isListed('product') && <p class="more-row"><a class="btn s" href={page}>{t.more}</a></p>}
  </div>
</section>

