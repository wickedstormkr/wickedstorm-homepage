---
/** 제품(홈): 역할별 제품 화면 탭 + 세 제품 요약. 자세한 내용은 제품 페이지로 */
import SecHead from '../components/SecHead.astro';
import RoleTabs from '../components/RoleTabs.astro';
import type { HomeContent } from '../lib/content';
import { pagePath, type Lang } from '../lib/i18n';
import { url } from '../lib/url';

interface Props { lang: Lang; t: HomeContent['product']; story: HomeContent['story']; lhub: HomeContent['learnhubble'] }
const { lang, t, story, lhub } = Astro.props;
const page = url(pagePath(lang, 'product'));
const cards = [
  { id: 'lecognizer', kicker: t.features[0].kicker, name: t.features[0].name, text: t.features[0].text, badge: t.features[0].badge, cls: 'lec' },
  { id: 'lecognizer-ai', kicker: t.features[1].kicker, name: t.features[1].name, text: t.features[1].text, badge: t.features[1].badge, cls: 'lec' },
  { id: 'learnhubble', kicker: lhub.eyebrow, name: lhub.name, text: lhub.lead, badge: lhub.principle, cls: 'lhb' },
];
---
<section class="band" id="product" aria-labelledby="product-title">
  <div class="wrap">
    <SecHead lang={lang} id="product-title" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />
    <RoleTabs t={t} story={story} id="home-role" />
    <ul class="prod-cards">
      {cards.map((c) => (
        <li class:list={['prod-card', c.cls]}>
          <p class="kick">{c.kicker}</p>
          <h3><a href={`${page}#${c.id}`}>{c.name}</a></h3>
          <p set:html={c.text} />
          <span class="feat-badge" set:html={c.badge} />
        </li>
      ))}
    </ul>
    <p class="more-row"><a class="btn s" href={page}>{t.more}</a></p>
  </div>
</section>

