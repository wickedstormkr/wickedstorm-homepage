---
/** 표준·1EdTech(홈): 표준 지도 한 장. 표준별 설명과 활동은 표준 페이지로 */
import SecHead from '../components/SecHead.astro';
import StdMap from '../components/StdMap.astro';
import type { HomeContent } from '../lib/content';
import { pagePath, type Lang } from '../lib/i18n';
import { url } from '../lib/url';

interface Props { lang: Lang; t: HomeContent['standards'] }
const { lang, t } = Astro.props;
---
<section class="band std" id="standards" aria-labelledby="std-title">
  <div class="wrap">
    <SecHead lang={lang} id="std-title" eyebrow={t.eyebrow} title={t.title} lead={t.lead}>
      <p class="std-badge"><span class="powered"><img class="sym" src={url('/img/symbol.png')} alt="" width="16" height="16" loading="lazy" /> <span set:html={t.badge} /></span></p>
    </SecHead>
    <StdMap t={t} />
    <p class="more-row"><a class="btn s" href={url(pagePath(lang, 'standards'))}>{t.more}</a></p>
  </div>
</section>
