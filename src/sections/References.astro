---
/** ⑤ 레퍼런스 */
import Img from '../components/Img.astro';
import SecHead from '../components/SecHead.astro';
import type { HomeContent } from '../lib/content';
import type { Lang } from '../lib/i18n';
import { phrase } from '../lib/phrase';

interface Props { lang: Lang; t: HomeContent['references'] }
const { lang, t } = Astro.props;
---
<section class="band" id="references" aria-labelledby="ref-title">
  <div class="wrap">
    <SecHead lang={lang} id="ref-title" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />
    <ul class="ref-grid">
      {t.cards.map((c) => (
        <li>
          <article class="ref-card">
            <p class="rorg" set:html={c.org} />
            <h3 set:html={phrase(c.title, lang)} />
            <p set:html={c.text} />
            <ul class="rtags">{c.tags.map((g) => <li set:html={g} />)}</ul>
          </article>
        </li>
      ))}
    </ul>
    <figure class="ref-logos"><Img name={t.logos.img} alt={t.logos.alt} sizes="(min-width: 1288px) 1240px, calc(100vw - 48px)" /></figure>
  </div>
</section>
