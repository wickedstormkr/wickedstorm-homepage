---
/** ② 파이프라인: 네 단계 + 파이프라인 루프(HTML/CSS 애니메이션, 멈춤 가능) */
import Img from '../components/Img.astro';
import SecHead from '../components/SecHead.astro';
import type { HomeContent } from '../lib/content';
import type { Lang } from '../lib/i18n';
import { phrase } from '../lib/phrase';

interface Props { lang: Lang; t: HomeContent['pipeline'] }
const { lang, t } = Astro.props;
const ARC = 'M 1283 664 C 1283 772, 317 772, 317 664';
---
<section class="band pipeline" aria-labelledby="pipeline-title">
  <div class="wrap">
    <SecHead lang={lang} id="pipeline-title" eyebrow={t.eyebrow} title={t.title} lead={t.lead} class="pipe-head" />
    <div class="pipe-rail" aria-hidden="true"></div>
    <ol class="pipe">
      {t.steps.map((s) => (
        <li class="step">
          <span class="n"><em>{s.index}</em> · {s.tag}</span>
          <h3 set:html={phrase(s.title, lang)} />
          <p set:html={s.text} />
          <p class="step-detail" set:html={s.detail} />
        </li>
      ))}
    </ol>
    <figure class="frame media-frame pipe-loop" id="pipeLoop">
      <div class="pl-stage">
        <div class="pl-head">
          <p class="pl-idx">{t.loop.index}</p>
          <p class="pl-title" set:html={phrase(t.loop.title, lang)} />
          <p class="pl-sub" set:html={t.loop.sub} />
        </div>
        <ol class="pl-steps">
          {t.loop.steps.map((s, i) => (
            <li class={`pl-step s${i + 1}`}>
              <p class="pl-lab"><i>{s.num}</i><span set:html={s.label} /></p>
              <p class="pl-note" set:html={s.note} />
              <div class="pl-win">
                <div class="pl-bar" aria-hidden="true"><span></span><span></span><span></span><em></em></div>
                <div class="pl-shot">
                  <Img name={s.img} alt={s.alt} sizes="(min-width: 1024px) 26vw, 92vw" />
                  <span class="pl-scan" aria-hidden="true"></span>
                </div>
                {i < 2 && <span class="pl-flow" aria-hidden="true"><i></i></span>}
              </div>
            </li>
          ))}
        </ol>
        <svg class="pl-arc" viewBox="0 0 1600 900" aria-hidden="true">
          <defs><linearGradient id="plArc" x1="1" x2="0"><stop offset="0" stop-color="#9a4bf0" stop-opacity=".65" /><stop offset="1" stop-color="#e930b0" stop-opacity=".65" /></linearGradient></defs>
          <path d={ARC} fill="none" stroke="url(#plArc)" stroke-width="2.5" stroke-dasharray="7 12"><animate attributeName="stroke-dashoffset" from="0" to="-190" dur="6s" repeatCount="indefinite" /></path>
          <circle r="7" fill="#fff"><animateMotion dur="12s" repeatCount="indefinite" path={ARC} /></circle>
        </svg>
        <p class="pl-arc-text" set:html={t.loop.arcText} />
      </div>
      <figcaption set:html={t.loop.caption} />
    </figure>
  </div>
</section>
