---
/** 404. 어느 언어에서 들어올지 모르므로 네 언어로 안내한다(각 줄에 lang). */
import Base from '../layouts/Base.astro';
import { getUi } from '../lib/content';
import { LANGS, LANG_NAME, homePath } from '../lib/i18n';
import { url } from '../lib/url';
const ko = getUi('ko').notFound;
---
<Base lang="ko" title="페이지를 찾을 수 없습니다 · WICKED STORM" description={ko.text} path="/404.html" homeHref={url('/')} noindex>
  <main id="main" tabindex="-1">
    <section class="band nf">
      <div class="wrap">
        <p class="eyebrow en">404</p>
        <h1 class="h-lg">{ko.title}</h1>
        <p class="sec-lead">{ko.text}</p>
        <ul class="nf-list">
          {LANGS.map((l) => {
            const t = getUi(l).notFound;
            return (
              <li lang={l}>
                {l !== 'ko' && <p class="nf-other"><b>{t.title}</b> {t.text}</p>}
                <a class="btn s" href={url(homePath(l))} hreflang={l}>{t.home} · {LANG_NAME[l]}</a>
              </li>
            );
          })}
        </ul>
        <p class="nf-news"><a href={url('/news.html')}>소식 · News</a></p>
      </div>
    </section>
  </main>
</Base>
<style>
  .nf{padding-top:calc(var(--header-h) + 80px);min-height:80svh}
  .nf h1{margin-top:12px}
  .nf-list{list-style:none;display:grid;gap:18px;margin-top:40px;max-width:760px}
  .nf-other{color:var(--muted);margin-bottom:10px}
  .nf-other b{color:var(--ink-2);margin-right:6px}
  .nf-news{margin-top:32px}
  .nf-news a{display:inline-flex;align-items:center;min-height:var(--tap);color:var(--accent);text-decoration:underline}
</style>
