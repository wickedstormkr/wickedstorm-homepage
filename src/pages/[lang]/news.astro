---
/** 언어별 소식 목록: /en/news.html, /ja/news.html, /vi/news.html (국문은 src/pages/news.astro) */
import NewsListPage from '../../views/NewsListPage.astro';
import { DEFAULT_LANG, LANGS, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LANGS.filter((l) => l !== DEFAULT_LANG).map((lang) => ({ params: { lang } }));
}
---
<NewsListPage lang={Astro.params.lang as Lang} />
