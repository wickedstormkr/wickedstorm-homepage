---
/** 언어별 페이지: /en/product.html, /ja/standards.html, /vi/contact.html … (국문은 src/pages/[page].astro) */
import ProductPage from '../../views/ProductPage.astro';
import StandardsPage from '../../views/StandardsPage.astro';
import CasesPage from '../../views/CasesPage.astro';
import TrustPage from '../../views/TrustPage.astro';
import CompanyPage from '../../views/CompanyPage.astro';
import ContactPage from '../../views/ContactPage.astro';
import { PAGES, PAGE_LANGS, DEFAULT_LANG, type Lang, type Page } from '../../lib/i18n';

export function getStaticPaths() {
  return PAGE_LANGS.filter((l) => l !== DEFAULT_LANG).flatMap((lang) => PAGES.map((page) => ({ params: { lang, page } })));
}
const lang = Astro.params.lang as Lang;
const page = Astro.params.page as Page;
const V = { product: ProductPage, standards: StandardsPage, cases: CasesPage, trust: TrustPage, company: CompanyPage, contact: ContactPage }[page];
---
<V lang={lang} />
