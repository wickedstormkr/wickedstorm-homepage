---
/** 국문 소식 기사(/news/<id>.html). 바깥 링크 글(externalUrl)은 만들지 않는다. 다른 언어는 src/pages/[lang]/news/[id].astro */
import ArticlePage from '../../views/ArticlePage.astro';
import { allPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.filter((p) => !p.externalUrl).map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: Post }
---
<ArticlePage lang="ko" post={Astro.props.post} />
