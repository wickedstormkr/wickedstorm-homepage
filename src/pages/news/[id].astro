---
/** 소식 상세(/news/<id>.html). 지금 사이트 생성기(news-artifacts.mjs)와 같은 모양·메타. 바깥 링크 글(externalUrl)은 만들지 않는다. */
import Base from '../../layouts/Base.astro';
// 페이지 스타일은 공통 스타일(Base: 토큰·기본) 뒤에 온다
import '../../styles/article.css';
import { allPosts, CATEGORY_KO, type Post } from '../../lib/posts';
import { describe, pictureHtml, renderBody } from '../../lib/article';
import { hasImg, img } from '../../lib/images';
import { homePath } from '../../lib/i18n';
import { absUrl, url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.filter((p) => !p.externalUrl).map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: Post }
const { post } = Astro.props;
const description = describe(post.summary, post.body);
const thumbName = post.thumb?.replace(/^\.\/img\//, '') ?? null;
const thumb = thumbName && hasImg(thumbName) ? thumbName : null;
const thumbHtml = thumb ? await pictureHtml(thumb, post.title, '(min-width: 808px) 728px, calc(100vw - 80px)', true) : '';
const body = (await renderBody(post.body)) || `<p>${description}</p>`;
const published = post.date.replace(/\./g, '-');
const ogImage = thumb ? new URL(img(thumb).src, absUrl('/')).href : '/img/og-image.png';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title,
  description,
  image: [thumb ? new URL(img(thumb).src, absUrl('/')).href : absUrl('/img/og-image.png')],
  datePublished: published,
  articleSection: CATEGORY_KO[post.category],
  mainEntityOfPage: { '@type': 'WebPage', '@id': absUrl(`/news/${post.id}.html`) },
  author: { '@type': 'Organization', name: '주식회사 위키드스톰', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: '주식회사 위키드스톰', logo: { '@type': 'ImageObject', url: absUrl('/img/og-image.png') } },
};
const back = url('/news.html');
---
<Base lang="ko" title={`${post.title} | 위키드스톰`} description={description} ogTitle={post.title} ogType="article"
  ogImage={ogImage}
  path={`/news/${post.id}.html`} homeHref={url(homePath('ko'))} current="news" jsonLd={jsonLd}>
  <meta slot="head" property="article:published_time" content={published} />
  <main id="main" tabindex="-1">
    <section class="band page-top">
      <div class="wrap">
        <article class="board-detail" aria-labelledby="article-title">
          <p class="detail-back detail-top"><a href={back}><span aria-hidden="true">←</span> 소식 목록으로</a></p>
          <div class="detail-eyebrow"><span class="ntag">{CATEGORY_KO[post.category]}</span> <time datetime={published}>{post.date}</time></div>
          <h1 id="article-title">{post.title}</h1>
          {thumb && <figure class="detail-thumb" set:html={thumbHtml} />}
          <div class="detail-body" set:html={body} />
          <p class="detail-back"><a href={back}><span aria-hidden="true">←</span> 소식 목록으로</a></p>
        </article>
      </div>
    </section>
  </main>
</Base>
