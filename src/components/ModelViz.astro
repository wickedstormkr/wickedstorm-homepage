---
/**
 * 에듀테크 · AI 학습분석 모델 카드의 작은 그림(빌드 때 그리는 SVG, 글자 없음, 저절로 움직이지 않는다).
 * - diagnose(학습 진단·추천): 개념 영역별 학습 수준 막대. 취약한 영역 하나(마젠타)에서 추천(점선)으로 이어진다
 * - signal(이상 학습 탐지): 홈 04 이상 신호 장면과 같은 분포(이번 학기 선 · 직전 학기 점선). 3주차 한 구간이 솟는다
 * - profile(LLM 학습자 프로파일링): 학습 과정 데이터(점)가 가운데(LLM)를 거쳐 성향 무리 셋으로 정리된다
 */
import { buildParticles, signalCurves, chartX, HOT_WEEK, SPIKE, VERB_COLOR } from '../lib/story-data';
import { rng } from '../lib/story-ledger';

interface Props { kind: string }
const { kind } = Astro.props;
const W = 320;
const H = 120;
const f = (v: number) => v.toFixed(1);
const id = `mv-${kind}`;
const [BLUE, VIOLET, MAGENTA] = [VERB_COLOR.watched, VERB_COLOR.answered, VERB_COLOR.submitted];

// diagnose: 다섯 영역의 수준(0~1). 세 번째가 취약 영역
const LEVELS = [0.86, 0.7, 0.3, 0.78, 0.62];
const WEAK = 2;
const rowY = (i: number) => 16 + i * 22;
const x0 = 14;
const x1 = 232;

// signal: 홈 이상 신호 장면의 분포를 그대로(같은 씨앗값)
let now = '';
let prev = '';
let area = '';
let spike: [number, number] = [0, 0];
if (kind === 'signal') {
  const { now: n, prev: p, G } = signalCurves(buildParticles());
  const X = (g: number) => 12 + (chartX(((g + 0.5) / G) * 6) - 0.035) / 0.94 * (W - 24);
  const Y = (v: number) => 104 - v * 88;
  const pts = (c: Float32Array) => Array.from({ length: G }, (_, g) => `${f(X(g))} ${f(Y(c[g]))}`);
  now = `M${pts(n).join('L')}`;
  prev = `M${pts(p).join('L')}`;
  area = `${now}L${f(X(G - 1))} 104L${f(X(0))} 104Z`;
  let best = 0;
  n.forEach((v, g) => { if (v > n[best]) best = g; });
  spike = [X(best), Y(n[best])];
}
const hotX = 12 + ((HOT_WEEK + SPIKE.at) / 6) * (W - 24);

// profile: 성향 무리 셋(색 = 무리), 가운데 LLM을 거쳐 정리된다
const r = rng(41);
const gauss = () => (r() + r() + r() - 1.5) / 1.5;
const GROUPS: [number, number, string][] = [[62, 34, BLUE], [262, 36, VIOLET], [170, 94, MAGENTA]];
const CORE: [number, number] = [160, 52];
const dots = GROUPS.flatMap(([cx, cy, c]) => Array.from({ length: 13 }, () => ({ x: cx + gauss() * 26, y: cy + gauss() * 13, c, o: 0.45 + r() * 0.5, s: 1.6 + r() * 1.6 })));
---
<svg class="model-viz" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-g`} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#e930b0" />
      <stop offset=".52" stop-color="#7c4dff" />
      <stop offset="1" stop-color="#2f7cff" />
    </linearGradient>
    <radialGradient id={`${id}-glow`}>
      <stop offset="0" stop-color="#e930b0" stop-opacity=".55" />
      <stop offset="1" stop-color="#e930b0" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={`${id}-fill`} x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#7c4dff" stop-opacity=".32" />
      <stop offset="1" stop-color="#7c4dff" stop-opacity="0" />
    </linearGradient>
  </defs>
  {kind === 'diagnose' && (
    <g>
      {LEVELS.map((v, i) => (
        <g>
          <rect x={x0} y={f(rowY(i) - 3)} width={x1 - x0} height="6" rx="3" fill="#fff" fill-opacity=".06" />
          <rect x={x0} y={f(rowY(i) - 3)} width={f((x1 - x0) * v)} height="6" rx="3" fill={i === WEAK ? MAGENTA : `url(#${id}-g)`} fill-opacity={i === WEAK ? 0.95 : 0.55} />
        </g>
      ))}
      <circle cx={f(x0 + (x1 - x0) * LEVELS[WEAK])} cy={rowY(WEAK)} r="14" fill={`url(#${id}-glow)`} />
      <circle cx={f(x0 + (x1 - x0) * LEVELS[WEAK])} cy={rowY(WEAK)} r="3.4" fill="#fff" />
      <path d={`M${f(x0 + (x1 - x0) * LEVELS[WEAK] + 8)} ${rowY(WEAK)}C${f(x1)} ${rowY(WEAK)} ${f(x1 + 10)} ${rowY(WEAK)} 290 ${rowY(WEAK)}`} fill="none" stroke="#a3b1ff" stroke-opacity=".7" stroke-width="1.4" stroke-dasharray="3 4" />
      <circle cx="298" cy={rowY(WEAK)} r="9" fill="none" stroke={`url(#${id}-g)`} stroke-width="2" />
      <circle cx="298" cy={rowY(WEAK)} r="3" fill="#a3b1ff" />
    </g>
  )}
  {kind === 'signal' && (
    <g>
      <rect x={f(hotX - 12)} y="10" width="24" height="96" rx="6" fill="#e930b0" fill-opacity=".08" />
      <line x1="12" x2={W - 12} y1="104.5" y2="104.5" stroke="#fff" stroke-opacity=".12" />
      <path d={area} fill={`url(#${id}-fill)`} />
      <path d={prev} fill="none" stroke="#a3b1ff" stroke-opacity=".6" stroke-width="1.3" stroke-dasharray="3 4" />
      <path d={now} fill="none" stroke="#eef1fb" stroke-opacity=".8" stroke-width="1.5" />
      <circle cx={f(spike[0])} cy={f(spike[1])} r="14" fill={`url(#${id}-glow)`} />
      <circle cx={f(spike[0])} cy={f(spike[1])} r="3.4" fill="#fff" />
    </g>
  )}
  {kind === 'profile' && (
    <g>
      {GROUPS.map(([cx, cy]) => <path d={`M${CORE[0]} ${CORE[1]}L${cx} ${cy}`} stroke="#a3b1ff" stroke-opacity=".28" stroke-width="1.2" />)}
      {GROUPS.map(([cx, cy, c]) => <ellipse cx={cx} cy={cy} rx="46" ry="24" fill={c} fill-opacity=".07" stroke={c} stroke-opacity=".28" />)}
      {dots.map((d) => <circle cx={f(d.x)} cy={f(d.y)} r={f(d.s)} fill={d.c} fill-opacity={d.o.toFixed(2)} />)}
      <circle cx={CORE[0]} cy={CORE[1]} r="16" fill="#0c0e1f" stroke={`url(#${id}-g)`} stroke-width="2" />
      <circle cx={CORE[0]} cy={CORE[1]} r="4" fill="#fff" />
    </g>
  )}
</svg>
