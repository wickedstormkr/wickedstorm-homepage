---
/** 홈(네 언어 공용). 순서: 여섯 장면(증빙 한 줄 포함) → 제품(역할별) → 표준 지도 → 사례 → 소식 → 회사 → 문의 → 자료 */
import Base from '../layouts/Base.astro';
// 페이지 스타일은 공통 스타일(Base: 토큰·기본) 뒤에 온다
import '../styles/cards.css';
import '../styles/home.css';
import '../styles/fragments.css';
import '../styles/story.css';
import '../styles/pages.css';
import Story from '../sections/Story.astro';
import Product from '../sections/Product.astro';
import Cases from '../sections/Cases.astro';
import Standards from '../sections/Standards.astro';
import News from '../sections/News.astro';
import Resources from '../sections/Resources.astro';
import Company from '../sections/Company.astro';
import Contact from '../sections/Contact.astro';
import { getHome, getUi } from '../lib/content';
import { LANGS, homePath, type Lang } from '../lib/i18n';
import { absUrl } from '../lib/url';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getHome(lang);
const ui = getUi(lang);
const alternates = Object.fromEntries(LANGS.map((l) => [l, homePath(l)])) as Record<Lang, string>;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '주식회사 위키드스톰',
  alternateName: 'Wicked Storm Inc.',
  foundingDate: '2021',
  taxID: '135-88-02020',
  url: absUrl('/'),
  logo: absUrl('/img/og-image.png'),
  slogan: 'Every Learning Moment, Designed for Growth.',
  email: 'manager@wickedstorm.kr',
  telephone: '+82-2-2205-1470',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '마곡중앙로 161-8, A동 901~905호',
    addressLocality: '강서구',
    addressRegion: '서울특별시',
    addressCountry: 'KR',
  },
};
---
<Base
  lang={lang}
  title={t.common.meta.title}
  description={t.common.meta.description}
  ogTitle={t.common.meta.ogTitle}
  ogDescription={t.common.meta.ogDescription}
  twitterTitle={t.common.meta.twitterTitle}
  twitterDescription={t.common.meta.twitterDescription}
  path={homePath(lang)}
  alternates={alternates}
  jsonLd={lang === 'ko' ? org : undefined}
  story
>
  <main id="main" tabindex="-1">
    <Story lang={lang} t={t.story} hero={t.hero} loop={t.product.loop} demoTopic={t.learnhubble.cta.topic} />
    <Product lang={lang} t={t.product} story={t.story} />
    <Standards lang={lang} t={t.standards} />
    <Cases lang={lang} t={t.cases} />
    <News lang={lang} t={t.news} ui={ui} />
    <Company lang={lang} t={t.company} ui={ui} />
    <Contact lang={lang} t={t.contact} ui={ui} />
    <Resources lang={lang} t={t.resources} />
  </main>
</Base>
