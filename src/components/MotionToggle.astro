---
/**
 * '움직임 멈춤' 버튼(KWCAG 6.2.2 정지 기능 제공, WCAG 2.2.2). 오프닝 이야기 조작(Story.astro .story-ctrl) 안에 둔다:
 * 저절로 계속 움직이는 것(실시간 수집 · 떠다니는 입자 · 반짝임)은 오프닝에만 있다.
 * 누르면 html.motion-paused가 붙어 반복 애니메이션이 모두 멈추고, 선택은 이 브라우저에 기억된다.
 * prefers-reduced-motion이면 멈춘 상태로 시작한다. aria-pressed="true" = 멈춘 상태(src/scripts/motion.ts).
 * 모양은 아이콘만(글은 화면 낭독기 · 툴팁으로).
 */
import { getUi } from '../lib/content';
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang }
const ui = getUi(Astro.props.lang);
---
<button class="motion-btn" type="button" data-motion-btn aria-pressed="false" title={ui.motion.label}>
  <span class="motion-ico" aria-hidden="true"></span>
  <span class="motion-txt"><span class="motion-pause">{ui.motion.pause}</span><span class="motion-play">{ui.motion.play}</span></span>
</button>
