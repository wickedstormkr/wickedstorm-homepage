---
/**
 * LearnHubble AI 운영자 · 교육과정 개정(1EdTech CASE): Lecognizer AI 이상 신호가 어느 수준의 문제인지 가르고,
 * 교육과정 수준이면 AI가 CASE 체계 보완을 추천한다: 역량(CFItem) 아래 학습성과를 선수학습으로 잇는 CFAssociation(precedes).
 * 반영은 운영자가 정한다. 글은 CASE 용어(CFDocument · CFItem · CFAssociation) 중심으로 짧게.
 * AI가 제안한 것(추천 상자와 체계 속 새 선수학습 칸)은 같은 AI 모양(.fx-ai · li.new)으로 이어 보이게 한다.
 * docs/source/mockups/lxp-case-revision.html · screens/cap-운영자-CASE개정.webp의 구성을 따른다.
 */
import Window from './Window.astro';
import type { HomeContent } from '../../lib/content';
interface Props { t: HomeContent['product']['operator']; label: string }
const { t, label } = Astro.props;
---
<Window class="fx-case" label={label} title={t.product} crumb={t.crumb}>
  <div class="fx-body">
    <p class="fx-signal">{t.signal}</p>
    <div class="fx-levels">
      <p class="fx-h">{t.levelLabel}</p>
      <ul>{t.levels.map((l) => <li class:list={{ on: l.on }}>{l.t}</li>)}</ul>
    </div>
    <div class="fx-case-grid">
      <div class="fx-tree">
        <p class="fx-h">{t.treeLabel}</p>
        <ul>
          {t.tree.map((n) => (
            <li class:list={[`lv${n.lv}`, n.tone]}><small>{n.k}</small><b>{n.v}</b>{n.s && <em>{n.s}</em>}</li>
          ))}
        </ul>
      </div>
      <div class="fx-ai">
        <div class="fx-ai-main">
          <span class="fx-ai-tag">{t.ai}</span>
          <div class="fx-ai-body">
            <p>{t.proposal}</p>
            <p class="fx-assoc"><span>{t.assoc.from}</span><span class="fx-rel"><code lang="en">{t.assoc.type}</code><span>{t.assoc.to}</span></span></p>
            <small>{t.note}</small>
          </div>
        </div>
      </div>
    </div>
    <div class="fx-foot">
      <span class="fx-note">{t.owner}</span>
      <span class="fx-actions" aria-hidden="true"><span class="fx-btn">{t.edit}</span><span class="fx-btn p">{t.apply}</span></span>
    </div>
  </div>
</Window>
