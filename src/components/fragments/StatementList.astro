---
/**
 * Lecognizer Statement 실시간 목록(운영자 화면). 행 하나가 xAPI 문장 하나, 점 색은 활동 종류(데이터 아트와 같은 색).
 * 표(table)로 두어 화면 낭독기가 칸 이름과 함께 읽는다. 폰에서는 칸을 두 줄로 접는다.
 */
import type { HomeContent } from '../../lib/content';
import { VERB_COLOR } from '../../lib/story-data';
interface Props { t: HomeContent['product']['stream']; label: string }
const { t, label } = Astro.props;
const color = (v: string) => (VERB_COLOR as Record<string, string>)[v] ?? (v === 'paused' || v === 'seeked' ? VERB_COLOR.watched : '#9aa3c0');
---
<figure class="fx fx-stream" aria-label={label}>
  <div class="fx-bar"><span class="fx-dots" aria-hidden="true"><i></i><i></i><i></i></span><b>{t.title}</b><span class="fx-live">{t.live}</span></div>
  <div class="fx-body">
    <table>
      <thead><tr><th scope="col">{t.cols.time}</th><th scope="col">{t.cols.actor}</th><th scope="col">{t.cols.verb}</th><th scope="col">{t.cols.object}</th></tr></thead>
      <tbody>
        {t.rows.map((r) => (
          <tr>
            <td class="tm">{r.time}</td>
            <td>{r.actor}</td>
            <td class="vb" lang="en"><i style={`background:${color(r.verb)}`} aria-hidden="true"></i>{r.verb}</td>
            <td>{r.object}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="fx-cap">{t.caption}</p>
  </div>
</figure>
