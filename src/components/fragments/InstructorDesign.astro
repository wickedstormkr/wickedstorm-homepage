---
/**
 * LearnHubble AI 교수자 · 수업 설계: 확인이 필요한 구간(세 칸, 칸마다 시각 · 구간 / 근거 두 줄) → AI 추천(보충 설명·확인 퀴즈) → 교수자가 고쳐서 적용.
 * 영역은 셋: 데이터(구간) · AI 영역(추천과 AI가 쓴 확인 퀴즈 초안을 한 상자에, .fx-ai) · 사람의 결정(아래 줄).
 * compact(이야기 장면 5): 신호가 온 구간 하나와 추천만. full(제품 역할 탭): 구간 셋, AI 영역 안에 추천과 퀴즈 초안을 나란히(운영자 화면과 같은 두 칸 짜임).
 * 라벨(시각·AI 추천)은 내용과 같은 줄에 두어 상자 높이를 늘리지 않는다.
 * 한 줄 상자(격자)의 칸 사이에는 띄어쓰기를 두지 않는다: 조판(typeset.ts)이 &nbsp;로 바꾸면 격자 칸이 하나 더 생긴다.
 */
import Window from './Window.astro';
import type { HomeContent } from '../../lib/content';
interface Props { t: HomeContent['story']['judge']; label: string; full?: boolean }
const { t, label, full = false } = Astro.props;
const segs = full ? t.segments : t.segments.filter((s) => s.hot);
---
<Window class:list={['fx-design', { compact: !full }]} label={label} title={t.product} crumb={t.crumb}>
  <div class="fx-body">
    <p class="fx-h">{t.segLabel}</p>
    <ul class="fx-segs">
      {segs.map((s) => (
        <li class:list={{ hot: s.hot }}><span class="fx-time tnum">{s.time}</span><span class="fx-seg-t"><b>{s.title}</b><small>{s.note}</small></span></li>
      ))}
    </ul>
    <div class="fx-ai">
      <div class="fx-ai-main">
        <span class="fx-ai-tag">{t.ai}</span>
        <div class="fx-ai-body">
          <p>{t.proposal}</p>
          <small>{t.detail}</small>
        </div>
      </div>
      {full && (
        <div class="fx-draft">
          <p class="fx-h">{t.quizLabel}</p>
          <ol>{t.quiz.map((q, i) => <li><i aria-hidden="true">Q{i + 1}</i><span>{q}</span></li>)}</ol>
        </div>
      )}
    </div>
    <div class="fx-foot">
      <span class="fx-note">{t.owner}</span>
      <span class="fx-actions" aria-hidden="true"><span class="fx-btn">{t.edit}</span><span class="fx-btn p">{t.apply}</span></span>
    </div>
  </div>
</Window>
