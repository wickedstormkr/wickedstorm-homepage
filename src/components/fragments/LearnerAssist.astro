---
/**
 * LearnHubble AI 학습자 · 강의실: 강의(확인이 필요한 구간은 교수자 화면과 같은 세 칸 상자)와 오른쪽 이 구간의 확인 퀴즈.
 * 교수자가 적용한 보충(‘금리 기초’ 보충 설명 · 확인 퀴즈)이 이어진다: 학습자가 그 구간에 이르면 확인 퀴즈가 자동으로 나온다.
 * 퀴즈 문항은 교수자 화면의 확인 퀴즈 초안(story.judge.quiz)을 그대로 쓴다(같은 퀴즈).
 * 퀴즈는 사람(교수자)이 정한 것이라 보통 칸, 그 아래 AI 힌트만 AI 영역 모양(정답 대신 보충 설명을 떠올리게). 질문 칸은 맨 아래.
 * 확인이 필요한 구간의 시각은 교수자 화면과 같게(신호가 온 구간은 시작–끝, 나머지는 한 시각).
 * 강의 영상은 그리지 않는다(원본 영상 속 일본어 슬라이드를 보이지 않게, CLAUDE.md).
 */
import Window from './Window.astro';
import type { HomeContent } from '../../lib/content';
interface Props { t: HomeContent['story']['next']; quiz: string; label: string }
const { t, quiz, label } = Astro.props;
const pct = (v: number) => `${(v * 100).toFixed(1)}%`;
---
<Window class="fx-learn" label={label} title={t.product} crumb={t.course}>
  <div class="fx-learn-grid">
    <div class="fx-lecture">
      <div class="fx-video" aria-hidden="true">
        <span class="fx-play"></span>
        <p>{t.lecture}</p>
      </div>
      <div class="fx-track" aria-hidden="true">
        <i style={`width:${pct(0.42)}`}></i>
        {t.marks.map((m) => <b class:list={{ hot: m.hot }} style={`left:${pct(m.at)}`}></b>)}
      </div>
      <p class="fx-clock tnum" aria-hidden="true">{t.time}</p>
      <p class="fx-h">{t.marksLabel}</p>
      <ul class="fx-segs mini">{t.marks.map((m) => <li class:list={{ hot: m.hot }}><span class="fx-time tnum">{m.label}</span><b>{m.title}</b></li>)}</ul>
    </div>
    <div class="fx-assist">
      <p class="fx-quiz-head"><span class="fx-tag">{t.quizHead}</span><span class="fx-note">{t.quizNote}</span></p>
      <div class="fx-quiz">
        <p>{quiz}</p>
        <ol>{t.choices.map((c, i) => <li><i aria-hidden="true">{String.fromCharCode(65 + i)}</i><span>{c}</span></li>)}</ol>
      </div>
      <div class="fx-msg ai"><span class="fx-ai-tag">{t.hintLabel}</span><p>{t.aiHint}</p><small>{t.aiSource}</small></div>
      <p class="fx-input" aria-hidden="true">{t.input}</p>
    </div>
  </div>
</Window>
