---
/**
 * LearnHubble AI 학습자 · 강의실: 강의(확인이 필요한 구간은 교수자 화면과 같은 세 칸 상자)와 오른쪽 AI 어시스턴트 대화.
 * 학습자가 막힌 구간을 묻고, AI는 정답 대신 비교 기준과 강의 근거를 건넨 뒤 구간 퀴즈로 이어 준다.
 * 대화: 학습자 말은 오른쪽(왼쪽 여백), AI 말은 왼쪽(오른쪽 여백)이고 AI 말과 구간 퀴즈는 다른 화면의 AI 영역과 같은 모양. 질문 칸은 맨 아래.
 * 확인이 필요한 구간의 시각은 교수자 화면과 같게(신호가 온 구간은 시작–끝, 나머지는 한 시각).
 * 강의 영상은 그리지 않는다(원본 영상 속 일본어 슬라이드를 보이지 않게, CLAUDE.md).
 */
import Window from './Window.astro';
import type { HomeContent } from '../../lib/content';
interface Props { t: HomeContent['story']['next']; label: string }
const { t, label } = Astro.props;
const pct = (v: number) => `${(v * 100).toFixed(1)}%`;
---
<Window class="fx-learn" label={label} title={t.product} crumb={t.course}>
  <div class="fx-learn-grid">
    <div class="fx-lecture">
      <div class="fx-video" aria-hidden="true">
        <span class="fx-play"></span>
        <p>{t.lecture}</p>
      </div>
      <div class="fx-track" aria-hidden="true">
        <i style={`width:${pct(0.42)}`}></i>
        {t.marks.map((m) => <b class:list={{ hot: m.hot }} style={`left:${pct(m.at)}`}></b>)}
      </div>
      <p class="fx-clock tnum" aria-hidden="true">{t.time}</p>
      <p class="fx-h">{t.marksLabel}</p>
      <ul class="fx-segs mini">{t.marks.map((m) => <li class:list={{ hot: m.hot }}><span class="fx-time tnum">{m.label}</span><b>{m.title}</b></li>)}</ul>
    </div>
    <div class="fx-assist">
      <p class="fx-h"><span class="fx-ai-tag">{t.panel}</span></p>
      <p class="fx-msg me">{t.ask}</p>
      <div class="fx-msg ai"><p>{t.hint}</p><small>{t.source}</small><span class="fx-tag">{t.quiz}</span></div>
      <p class="fx-input" aria-hidden="true">{t.input}</p>
    </div>
  </div>
</Window>
