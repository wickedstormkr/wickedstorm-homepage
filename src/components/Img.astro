---
/**
 * 콘텐츠 이미지. Astro 자산 처리로 AVIF·WebP와 폭별 srcset을 만든다.
 * name: src/assets/img 기준 파일 이름(콘텐츠 파일에 적힌 그대로).
 * sizes: 화면에 그려지는 폭. 알맞게 주면 폰이 큰 원본을 받지 않는다.
 */
import { Picture } from 'astro:assets';
import { img } from '../lib/images';

interface Props {
  name: string;
  alt: string;
  sizes: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const { name, alt, sizes, class: cls, loading = 'lazy', fetchpriority } = Astro.props;
const src = img(name);
// 원본보다 크게 만들지 않는다
const widths = [360, 480, 640, 800, 1024, 1280, 1600, 1920].filter((w) => w < src.width).concat(src.width);
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={widths}
  sizes={sizes}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={cls}
/>
