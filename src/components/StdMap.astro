---
/**
 * 표준 지도: 학습데이터가 지나는 길(수집 → 체계 → 증명 → 연동)로 표준을 묶고, 상태(적용·적용 예정·설계 참조)를 표시한다.
 * 표준마다 공식 스펙으로 가는 링크(주장은 확인할 수 있게).
 */
import type { HomeContent } from '../lib/content';
interface Props { t: HomeContent['standards'] }
const { t } = Astro.props;
const byName = new Map(t.cards.map((c) => [c.name, c]));
const legend = [...new Map(t.cards.map((c) => [c.status, c.statusLabel])).entries()];
---
<div class="std-map">
  <ol class="std-lanes">
    {t.map.groups.map((g, gi) => (
      <li class="std-lane">
        <p class="lane-head"><span class="lane-n" aria-hidden="true">{String(gi + 1).padStart(2, '0')}</span><b>{g.name}</b></p>
        <p class="lane-desc">{g.desc}</p>
        <ul class="lane-items">
          {g.items.map((n) => {
            const c = byName.get(n)!;
            return (
              <li>
                <a class:list={['std-chip', c.status]} href={c.href} target="_blank" rel="noopener noreferrer" aria-label={`${c.statusLabel} · ${c.ariaLabel}`}>
                  <b lang="en">{c.name}</b><span>{c.statusLabel}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </li>
    ))}
  </ol>
  <ul class="std-legend" aria-label={t.map.legendLabel}>
    {legend.map(([k, v]) => <li><i class:list={['dot', k]} aria-hidden="true"></i>{v}</li>)}
  </ul>
</div>
