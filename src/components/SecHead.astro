---
/** 섹션 머리: 로고 심볼 + 아이브로우, 제목(h2), 리드 */
import type { Lang } from '../lib/i18n';
import { phrase } from '../lib/phrase';
import { sents } from '../lib/sents';
import { url } from '../lib/url';

interface Props { lang: Lang; id: string; eyebrow: string; title: string; lead?: string; class?: string }
const { lang, id, eyebrow, title, lead, class: cls } = Astro.props;
---
<div class:list={['sec-head', cls]}>
  <p class="eyebrow"><img class="sym" src={url('/img/symbol.png')} alt="" width="16" height="16" loading="lazy" /> <span set:html={eyebrow} /></p>
  <h2 class="h-lg" id={id} set:html={phrase(title, lang)} />
  {lead && <p class="sec-lead" set:html={phrase(sents(lead), lang)} />}
  <slot />
</div>
