{
  "name": "wickedstorm-homepage",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/fonts/subset.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:content": "node scripts/checks/content.mjs",
    "test:links": "node scripts/checks/links.mjs",
    "test:links:external": "node scripts/checks/links.mjs --external",
    "test:e2e": "playwright test",
    "test:lh": "lhci autorun --config=lighthouserc.cjs",
    "test": "npm run test:content && npm run test:links && npm run test:e2e",
    "report": "node scripts/checks/report.mjs",
    "migrate:home": "node scripts/migrate/extract-home.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "gsap": "3.13",
    "lenis": "^1.3.26",
    "ogl": "^1.0.11",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.56.1",
    "budoux": "^0.9.2",
    "node-html-parser": "^9.0.4",
    "playwright-core": "1.56.1",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@puppeteer/browsers": "^3.2.3",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
  }
}
